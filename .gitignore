.DS_Store
node_modules/
dist/
.vscode/
.idea/
*.log
.env

# Claude Code — personal/local settings (allowlist for the autonomous loop)
.claude/settings.local.json

# devloop friction log — fed to /iterate at end of run, not committed
LOOP-FRICTION.jsonl

# wrangler (Cloudflare Workers CLI) local state
.wrangler/
.dev.vars
wrangler.local.toml

# menu bar app — build output, not source
# `usagebar` and `usagebar.app/` are produced by ops/menubar/build.sh and
# bundle.sh from the .swift files + popover.html sitting next to them. They are
# ~645KB of arch-specific Mach-O, and usagebar.app bundles a COPY of
# popover.html — committing it would put two versions of the same file in the
# repo, and the stale copy is the one that actually runs.
ops/menubar/usagebar
ops/menubar/usagebar.app/
